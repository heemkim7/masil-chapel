 },
 "lines": [
  {
   "id": "pastor_greet_0",
   "who": "pastor",
   "cat": "greet",
   "text": "어서 오세요, 마실채플에 오신 걸 환영해요."
  },
  {
   "id": "pastor_greet_1",
   "who": "pastor",
   "cat": "greet",
   "text": "오늘도 이렇게 와 주셔서 정말 반가워요."
  },
  {
   "id": "pastor_greet_2",
   "who": "pastor",
   "cat": "greet",
   "text": "편한 자리에 앉으세요. 곧 예배가 시작돼요."
  },
  {
   "id": "pastor_greet_3",
   "who": "pastor",
   "cat": "greet",
   "text": "먼 길 오셨네요. 따뜻한 마음으로 함께해요."
  },
  {
   "id": "pastor_greet_4",
   "who": "pastor",
   "cat": "greet",
   "text": "동네 이웃과 함께하니 예배당이 환해지네요."
  },
  {
   "id": "pastor_svc_0",
   "who": "pastor",
   "cat": "svc",
   "text": "이제 예배를 시작하겠습니다. 다 함께 찬양해요."
  },
  {
   "id": "pastor_svc_1",
   "who": "pastor",
   "cat": "svc",
   "text": "함께 기도하겠습니다."
  },
  {
   "id": "pastor_svc_2",
   "who": "pastor",
   "cat": "svc",
   "text": "말씀을 함께 읽겠습니다."
  },
  {
   "id": "pastor_svc_3",
   "who": "pastor",
   "cat": "svc",
   "text": "감사의 마음을 헌금으로 드리겠습니다."
  },
  {
   "id": "pastor_svc_4",
   "who": "pastor",
   "cat": "svc",
   "text": "축도하겠습니다."
  },
  {
   "id": "pastor_svc_5",
   "who": "pastor",
   "cat": "svc",
   "text": "함께 예배해 주셔서 감사합니다. 평안히 가세요."
  },
  {
   "id": "pastor_tips_0",
   "who": "pastor",
   "cat": "tips",
   "text": "의자 앞에서 이 키를 누르면 앉을 수 있어요."
  },
  {
   "id": "pastor_tips_1",
   "who": "pastor",
   "cat": "tips",
   "text": "예배당 곳곳에 반짝이는 골드가 숨어 있어요."
  },
  {
   "id": "pastor_tips_2",
   "who": "pastor",
   "cat": "tips",
   "text": "헌금이 모이면 예배당이 더 아름다워져요."
  },
  {
   "id": "pastor_tips_3",
   "who": "pastor",
   "cat": "tips",
   "text": "예배가 끝나면 다 같이 단체사진을 찍어요."
  },
  {
   "id": "pastor_tips_4",
   "who": "pastor",
   "cat": "tips",
   "text": "오늘의 인도자가 되어 말씀을 나눠 보세요."
  },
  {
   "id": "pastor_tips_5",
   "who": "pastor",
   "cat": "tips",
   "text": "게시판에 기도 제목을 남기면 이웃이 함께 기도해요."
  },
  {
   "id": "pastor_upgrade_0",
   "who": "pastor",
   "cat": "upgrade",
   "text": "예배당이 한층 아름다워졌어요. 모두의 정성 덕분이에요."
  },
  {
   "id": "pastor_upgrade_1",
   "who": "pastor",
   "cat": "upgrade",
   "text": "와, 샹들리에가 정말 반짝이네요."
  },
  {
   "id": "pastor_upgrade_2",
   "who": "pastor",
   "cat": "upgrade",
   "text": "이렇게 멋진 예배당이 되다니, 감사할 뿐이에요."
  },
  {
   "id": "pastor_bless_0",
   "who": "pastor",
   "cat": "bless",
   "text": "오늘 하루도 주님의 평안이 함께하길 바라요."
  },
  {
   "id": "pastor_bless_1",
   "who": "pastor",
   "cat": "bless",
   "text": "지친 마음에 쉼이 있기를 기도할게요."
  },
  {
   "id": "pastor_bless_2",
   "who": "pastor",
   "cat": "bless",
   "text": "작은 친절이 동네를 밝혀요."
  },
  {
   "id": "pastor_bless_3",
   "who": "pastor",
   "cat": "bless",
   "text": "걱정은 내려놓고 감사 한 가지를 떠올려 봐요."
  },
  {
   "id": "gwon_talk_0",
   "who": "gwon",
   "cat": "talk",
   "text": "어머, 새로 온 이웃이구나. 반가워요."
  },
  {
   "id": "gwon_talk_1",
   "who": "gwon",
   "cat": "talk",
   "text": "우리 예배당은 사십 년이나 됐답니다."
  },
  {
   "id": "gwon_talk_2",
   "who": "gwon",
   "cat": "talk",
   "text": "찬양 시간이 제일 좋아요. 목소리 크게 내요."
  },
  {
   "id": "gwon_talk_3",
   "who": "gwon",
   "cat": "talk",
   "text": "헌금은 마음이 중요하지요."
  },
  {
   "id": "gwon_talk_4",
   "who": "gwon",
   "cat": "talk",
   "text": "오늘도 와 줘서 고마워요."
  },
  {
   "id": "gwon_talk_5",
   "who": "gwon",
   "cat": "talk",
   "text": "옆자리 비었어요. 이리 앉아요."
  },
  {
   "id": "gwon_talk_6",
   "who": "gwon",
   "cat": "talk",
   "text": "기도 제목 있으면 언제든 말해요."
  },
  {
   "id": "gwon_talk_7",
   "who": "gwon",
   "cat": "talk",
   "text": "목사님 말씀이 오늘 참 좋네요."
  },
  {
   "id": "yuna_talk_0",
   "who": "yuna",
   "cat": "talk",
   "text": "안녕! 나 유나야. 같이 앉을래?"
  },
  {
   "id": "yuna_talk_1",
   "who": "yuna",
   "cat": "talk",
   "text": "여기 의자 진짜 폭신해."
  },
  {
   "id": "yuna_talk_2",
   "who": "yuna",
   "cat": "talk",
   "text": "예배 끝나면 단체사진 찍자!"
  },
  {
   "id": "yuna_talk_3",
   "who": "yuna",
   "cat": "talk",
   "text": "바닥에 골드 떨어진 거 봤어?"
  },
  {
   "id": "yuna_talk_4",
   "who": "yuna",
   "cat": "talk",
   "text": "헌금 많이 모이면 예배당이 바뀐대."
  },
  {
   "id": "yuna_talk_5",
   "who": "yuna",
   "cat": "talk",
   "text": "오늘 찬양 박자 맞추기 자신 있어!"
  },
  {
   "id": "yuna_talk_6",
   "who": "yuna",
   "cat": "talk",
   "text": "인도자 해 보고 싶다."
  },
  {
   "id": "yuna_talk_7",
   "who": "yuna",
   "cat": "talk",
   "text": "다음 주에도 꼭 와!"
  },
  {
   "id": "haeun_talk_0",
   "who": "haeun",
   "cat": "talk",
   "text": "안녕하세요! 저는 하은이에요."
  },
  {
   "id": "haeun_talk_1",
   "who": "haeun",
   "cat": "talk",
   "text": "별 다섯 개 찾으면 목사님이 선물 주신대요."
  },
  {
   "id": "haeun_talk_2",
   "who": "haeun",
   "cat": "talk",
   "text": "예배당 안에 들어가 봤어요?"
  },
  {
   "id": "haeun_talk_3",
   "who": "haeun",
   "cat": "talk",
   "text": "꽃밭에 반짝이는 게 있어요."
  },
  {
   "id": "haeun_talk_4",
   "who": "haeun",
   "cat": "talk",
   "text": "오늘 날씨 진짜 좋다!"
  },
  {
   "id": "haeun_talk_5",
   "who": "haeun",
   "cat": "talk",
   "text": "같이 찬양해요!"
  },
  {
   "id": "lamb_talk_0",
   "who": "lamb",
   "cat": "talk",
   "text": "메에. 안녕!"
  },
  {
   "id": "lamb_talk_1",
   "who": "lamb",
   "cat": "talk",
   "text": "메에, 간식 있어?"
  },
  {
   "id": "lamb_talk_2",
   "who": "lamb",
   "cat": "talk",
   "text": "메에에, 나도 예배당 갈래."
  },
  {
   "id": "lamb_talk_3",
   "who": "lamb",
   "cat": "talk",
   "text": "메에, 친구 생겼다!"
  }
 ]
}